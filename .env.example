# ===== Novel Engine configuration =====
# Copy to .env and adjust values.

# application
NOVEL_ENVIRONMENT=development
NOVEL_API_PREFIX=/api/v1

# database (SQLite for local MVP; PostgreSQL-ready)
# async driver used by the app:
NOVEL_DATABASE_URL=sqlite+aiosqlite:///./novel_engine.db
# sync driver used by alembic migrations:
NOVEL_SYNC_DATABASE_URL=sqlite:///./novel_engine.db

# Real providers (also read from this .env file; restart after editing).
# DeepSeek official. Keep separate from the SCNet account key.
NOVEL_DEEPSEEK_API_KEY=
# SCNet (legacy name preserved for existing trials).
NOVEL_LLM_API_KEY=
NOVEL_LLM_BASE_URL=https://api.scnet.cn/api/llm/v1
# BASE_URL above is for the trial CLI. App runtime uses the nested config:
# copy config.example.yaml to config.yaml, or configure providers explicitly.
NOVEL_LLM__PROVIDERS__SCNET__BASE_URL=https://api.scnet.cn/api/llm/v1

# development-only: export preview artifacts to this directory (empty = off)
NOVEL_PREVIEW_ARTIFACT_DIR=

# default agent model assignments (override per-agent in config.yaml)
# NOVEL_LLM__AGENTS__DIRECTOR__MODEL=DeepSeek-V4.1-Flash-1017
# NOVEL_LLM__AGENTS__WRITER__MODEL=DeepSeek-V4.1-Flash-1017
# NOVEL_LLM__AGENTS__MEMORY_EXTRACTOR__MODEL=DeepSeek-V4.1-Flash-1017
# NOVEL_LLM__AGENTS__CONTINUITY_CHECKER__MODEL=DeepSeek-V4.1-Flash-1017
